# ===================================================
# SIMTELE-RISK - Variables de Entorno de Ejemplo
# ===================================================
# Copia este archivo como .env para desarrollo local
# En Vercel: agrégalas en Settings -> Environment Variables

# Configuración de Base de Datos en Turso (LibSQL)
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=<TU_TURSO_AUTH_TOKEN_AQUI>

# Configuración de la Aplicación Flask
FLASK_ENV=production
SECRET_KEY=clave_secreta_super_segura_para_sesiones_flask
PORT=5000
